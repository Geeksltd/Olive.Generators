<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <StartupObject>OliveGenerator.Program</StartupObject>
    <AssemblyName>Olive.ApiProxyGenerator</AssemblyName>
    <RootNamespace>Olive</RootNamespace>
    <PackageId>generate-api-proxy</PackageId>
    <Title>Olive Api Proxy Generator</Title>
    <Authors>Geeks Ltd</Authors>
    <PackageProjectUrl>https://github.com/Geeksltd/Olive/blob/master/Integration/Olive.Microservices/Integration.md</PackageProjectUrl>
    <PackageIconUrl>http://licensing.msharp.co.uk/Images/OliveComponent.png</PackageIconUrl>
    <Copyright>Copyright ©2018 Geeks Ltd - All rights reserved.</Copyright>
    <Description>Generates Api Proxy packages for Olive microservice Apis</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>1701;1702;1705;NU1701</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>generate-api-proxy</ToolCommandName>
    <Version>10.4.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.14" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <!-- NuGet.Packaging brings 8.0.1, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="olive" Version="10.2.5" />
    <PackageReference Include="Olive.Entities" Version="10.4.5" />
  </ItemGroup>
  <Import Project="..\DTO\DTO.projitems" Label="Shared" />
  <Import Project="..\SharedNew\SharedNew.projitems" Label="Shared" />
</Project>
